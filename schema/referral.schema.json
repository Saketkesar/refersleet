{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Refersleet Referral Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "status",
    "category",
    "country",
    "official_website",
    "reward",
    "eligibility",
    "requirements",
    "terms_url",
    "submitted_by",
    "submitted_at",
    "last_verified",
    "verification",
    "tags",
    "description",
    "redirect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "pending", "flagged", "archived"]
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "minItems": 1
    },
    "official_website": {
      "type": "string",
      "format": "uri"
    },
    "reward": {
      "type": "object",
      "required": ["referrer", "referred_user", "type", "description"],
      "properties": {
        "referrer": { "type": "string" },
        "referred_user": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "sale_reward_cps",
            "lead_reward_cpl",
            "click_reward_cpc",
            "dual_sided",
            "cashback",
            "discount",
            "credits",
            "free_trial",
            "points",
            "crypto",
            "gift_card",
            "other"
          ]
        },
        "description": { "type": "string" }
      }
    },
    "eligibility": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "terms_url": {
      "type": "string",
      "format": "uri"
    },
    "submitted_by": {
      "type": "object",
      "required": ["username", "display_name"],
      "properties": {
        "username": { "type": "string" },
        "display_name": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "submitted_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verification": {
      "type": "object",
      "required": ["status", "working_votes", "not_working_votes", "reward_changed_votes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["community-verified", "official-verified", "unverified", "stale", "flagged"]
        },
        "working_votes": { "type": "integer", "minimum": 0 },
        "not_working_votes": { "type": "integer", "minimum": 0 },
        "reward_changed_votes": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "screenshots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "notes": {
      "type": "string"
    },
    "redirect": {
      "type": "object",
      "required": ["redirect_slug", "disclosure_required"],
      "properties": {
        "redirect_slug": { "type": "string" },
        "disclosure_required": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "destination_url": { "type": "string" }
      }
    }
  }
}
