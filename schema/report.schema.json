{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RefX Issue Report Schema",
  "type": "object",
  "required": ["referral_id", "reason", "details", "reported_at"],
  "properties": {
    "referral_id": { "type": "string" },
    "reason": {
      "type": "string",
      "enum": ["not_working", "reward_changed", "eligibility_changed", "program_ended", "misleading", "malicious_link", "other"]
    },
    "details": { "type": "string", "minLength": 5 },
    "reported_by": { "type": "string" },
    "reported_at": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "investigating", "resolved", "dismissed"]
    }
  }
}
